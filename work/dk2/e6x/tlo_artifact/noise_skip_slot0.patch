     dims = (2,) if mix["band"].startswith("temporal") else (3, 4)
     fa, fb = torch.fft.fftn(a, dim=dims), torch.fft.fftn(b, dim=dims)
     return torch.fft.ifftn(mask * fb + (1 - mask) * fa, dim=dims).real
