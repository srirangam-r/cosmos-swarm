// Tailnet policy for the hackathon swarm.
//
// Use it in a tailnet created only for the hackathon. Paste it into the Tailscale admin
// console under Access controls. It replaces the default allow-all policy, so anything
// not listed here is denied. The "tests" block is checked when you save: if a rule
// lets an agent machine reach something it shouldn't, the save is rejected.
//
// Machines: the always-on board machine (it also hosts the referee and shared services, and
// runs no agents) is tagged tag:swarm-board; every machine that runs agents is tagged
// tag:swarm-agent. Tag with tagged auth keys, or in the admin console (Machines -> Edit ACL tags).
{
	"tagOwners": {
		"tag:swarm-board": ["autogroup:admin"],
		"tag:swarm-agent": ["autogroup:admin"],
	},

	"acls": [
		// The board machine: dashboard and agent API (8000), shared services such as a Cosmos3-Nano
		// endpoint or the planted-case referee (8001-8099; the referee's default is 8090).
		{"action": "accept", "src": ["autogroup:member", "tag:swarm-agent"], "dst": ["tag:swarm-board:8000-8100"]},

		// Services machines share with each other (e.g. a Cosmos3-Nano endpoint), on ports 8001-8099 only.
		{"action": "accept", "src": ["autogroup:member", "tag:swarm-agent"], "dst": ["tag:swarm-agent:8001-8099"]},

		// Port 22 for shared compute. Tailscale SSH needs this network rule as well as the "ssh"
		// rule below, which then limits logins to the "swarm" user on machines running Tailscale SSH.
		// (A machine that doesn't share compute still has its own SSH server, needing its own keys.)
		{"action": "accept", "src": ["autogroup:member", "tag:swarm-agent", "tag:swarm-board"], "dst": ["tag:swarm-board:22", "tag:swarm-agent:22"]},
	],

	// Shared compute: agents (and people) may SSH into any swarm machine, but only as the
	// unprivileged "swarm" user that swarm/share_compute.sh creates on machines that opt in.
	// Never as root or as the machine owner. "accept" (not "check") so agents can use it unattended.
	"ssh": [
		{"action": "accept", "src": ["autogroup:member", "tag:swarm-agent", "tag:swarm-board"], "dst": ["tag:swarm-agent", "tag:swarm-board"], "users": ["swarm"]},
	],

	"tests": [
		{
			"src":    "tag:swarm-agent",
			"accept": ["tag:swarm-board:8000", "tag:swarm-board:8100", "tag:swarm-board:8001", "tag:swarm-board:22", "tag:swarm-agent:8001", "tag:swarm-agent:8099", "tag:swarm-agent:22"],
			"deny":   ["tag:swarm-board:8101", "tag:swarm-board:5432", "tag:swarm-agent:8000", "tag:swarm-agent:5432"],
		},
		{
			"src":  "tag:swarm-board",
			"deny": ["tag:swarm-agent:8001", "tag:swarm-agent:5432"],
		},
	],

	"sshTests": [
		{"src": "tag:swarm-agent", "dst": ["tag:swarm-board", "tag:swarm-agent"], "accept": ["swarm"], "deny": ["root"]},
	],
}
